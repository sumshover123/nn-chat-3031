doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    title NNおみくじ
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto NNおみくじ
          i.bi-envelope-paper-heart-fill.ms-1
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") メニュー
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードに切り替え' : 'ライトモードに切り替え');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}

    //- メインコンテンツエリア（中央配置）
    div.row.justify-content-center(style="margin-top: 100px; margin-bottom: 50px;")
      div.col-md-6.text-center
        
        //- 今回引いた結果の表示
        if fortune
          div.card.my-4.border-primary.shadow
            div.card-body.p-5
              h2.card-title.text-muted 今日の運勢は...
              h1.display-1.text-danger.fw-bold.my-4 #{fortune}
        else
          div.my-5
            p.lead.text-muted ボタンを押して今日の運勢を占いましょう！

        //- おみくじを引くボタン
        form(method="post" action="/posts")
          input(type="hidden" name="oneTimeToken" value=oneTimeToken)
          button(type="submit").btn.btn-danger.btn-lg.px-5.py-3.fs-3.shadow
            i.bi-box-seam.me-2
            | おみくじを引く

        //- 前回の結果表示（Cookieから取得した値がある場合）
        if lastFortune
          div.alert.alert-secondary.mt-5(role="alert")
            i.bi-clock-history.me-2
            | 前回の結果：
            strong.fs-4.ms-1 #{lastFortune}

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")
    script(src="nn-chat.js")